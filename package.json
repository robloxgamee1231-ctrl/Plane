{
  "name": "ndx-flight-disaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:worlds": "node tests/worlds.mjs",
    "test:production": "node tests/production.mjs",
    "build:site": "tsc --noEmit && vite build --mode pages --base ./ --outDir out/site",
    "test:site": "node tests/site.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.17.3",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^140.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
